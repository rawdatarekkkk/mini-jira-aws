# Backend API (Member 4). Use a trailing path of /api — call paths like api.get("users/me").
VITE_API_BASE_URL=http://localhost:5001/api

# Must match backend/.env: same User Pool, same App client, same region (Member 5).
# Backend verifies the Cognito ID token (Bearer) with issuer + audience = app client id.
VITE_AWS_REGION=eu-north-1
VITE_COGNITO_USER_POOL_ID=PUT_LATER
VITE_COGNITO_CLIENT_ID=PUT_LATER

# Cognito users need custom:role (manager | employee | admin) or the API returns 401.
